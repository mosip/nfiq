# Patterns without a leading "/" match at any depth (root and every module).

# ── Build output ─────────────────────────────────────────────
target/

# ── Local run artefacts (run-local-JP2 / run-local-WSQ) ──────
.local/
logs/
*.log

# ── Eclipse / STS ────────────────────────────────────────────
.metadata/
.settings/
.classpath
.project
.factorypath

# ── IntelliJ / VS Code / SonarLint ───────────────────────────
.idea/
*.iml
.vscode/
.sonarlint/
.scannerwork/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
