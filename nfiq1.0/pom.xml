<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  MOSIP NFIQ 1.0 — Java implementation of NIST Fingerprint Image Quality 1.0
  ============================================================================
  Artifact : io.mosip:nfiq1.0 (plain library JAR — no Spring Boot app, no HTTP)
  Parent   : io.mosip:nfiq (../pom.xml) → spring-boot-starter-parent.
             Java 21 + preview, plugin versions, MOSIP/third-party versions,
             JaCoCo 90% gate, Sonar and Maven Central publishing are inherited.
  This POM : dependencies, coverage excludes, JAR manifest, target/lib copy,
             sample-ISO handling.

  Build    : mvn clean install "-Dgpg.skip=true"   (here, or from the repo root)
  Run      : run-local-JP2.(bat|sh) | run-local-WSQ.(bat|sh)  [build] [0|1]  (this folder)
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.mosip</groupId>
		<artifactId>nfiq</artifactId>
		<version>0.1.2-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>nfiq1.0</artifactId>
	<!-- Same as the parent version; kept explicit because CI and release tooling read it here. -->
	<version>0.1.2-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>nfiq1.0</name>
	<description>
		MOSIP NFIQ 1.0: a from-scratch Java implementation of the NIST Fingerprint Image
		Quality 1.0 algorithm. Decodes JPEG2000 / WSQ fingerprints from ISO/IEC 19794-4
		records, runs the MINDTCT minutiae detector and the NFIQ multi-layer perceptron,
		and returns a quality score of 1 (best) to 5 (worst) plus a confidence value.
		Consumed as a library by MOSIP Biometric SDK, ID Authentication, Registration
		Processor and MDS.
	</description>
	<url>https://github.com/mosip/nfiq</url>

	<!--
		Declared again here (not only in the parent) because Maven Central validates each
		published POM, and inherited url/scm values would otherwise get "/nfiq1.0" appended.
	-->
	<licenses>
		<license>
			<name>MPL 2.0</name>
			<url>https://www.mozilla.org/en-US/MPL/2.0/</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<scm>
		<connection>scm:git:git://github.com/mosip/nfiq.git</connection>
		<developerConnection>scm:git:ssh://github.com:mosip/nfiq.git</developerConnection>
		<url>https://github.com/mosip/nfiq</url>
		<tag>HEAD</tag>
	</scm>

	<developers>
		<developer>
			<name>MOSIP</name>
			<email>mosip.emailnotifier@gmail.com</email>
			<organization>io.mosip</organization>
			<organizationUrl>https://github.com/mosip/nfiq</organizationUrl>
		</developer>
	</developers>

	<dependencies>
		<!-- ── MOSIP ─────────────────────────────────────────────────────────── -->
		<!-- Decodes ISO fingerprint records to raw greyscale pixels before scoring. -->
		<dependency>
			<groupId>io.mosip.biometric.util</groupId>
			<artifactId>biometrics-util</artifactId>
			<exclusions>
				<exclusion>
					<groupId>io.mosip.kernel</groupId>
					<artifactId>kernel-core</artifactId>
				</exclusion>			</exclusions>
		</dependency>
		<!--
			biometrics-util needs kernel-core classes (e.g. BaseUncheckedException) at runtime, but
			none of kernel-core's transitive graph. That graph carries licenses MOSIP does not allow
			(EPL/LGPL/GPL-CE/CC-BY: Logback, AspectJ, jakarta.transaction/annotation, mchange,
			openhtmltopdf, findbugs annotations, jcip) plus banned JUnit 4 / vintage, so it is cut.
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-core</artifactId>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- ── Image codecs (versions managed in the parent) ─────────────────── -->
		<!-- jai-imageio-jpeg2000: JPEG2000 (JP2/J2K) reader for ISO payloads. -->
		<dependency>
			<groupId>com.github.jai-imageio</groupId>
			<artifactId>jai-imageio-jpeg2000</artifactId>
		</dependency>
		<!-- jnbis: WSQ fingerprint codec. -->
		<dependency>
			<groupId>com.github.mhshams</groupId>
			<artifactId>jnbis</artifactId>
		</dependency>

		<!-- ── Logging ───────────────────────────────────────────────────────── -->
		<!--
			slf4j-api: logging facade used by every class. Version from Boot parent. License: MIT.
			No binding is shipped on purpose: the consuming MOSIP service supplies its own backend.
			Tests and the launchers get Logback from spring-boot-starter-test (test scope only).
			Local/test config: src/test/resources/logback-test.xml.
		-->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>

		<!-- ── Compile-time only ─────────────────────────────────────────────── -->
		<!-- lombok: @Data/@Getter/@Setter code generation. Scope provided. License: MIT. -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- ── Test ──────────────────────────────────────────────────────────── -->
		<!--
			spring-boot-starter-test: JUnit Jupiter, Mockito (inline mock maker is the
			default since Mockito 5, so mockito-inline is no longer needed), AssertJ and
			spring-test (ReflectionTestUtils). Version from Boot parent. Scope: test.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<!--
			Sample fingerprints (src/test/resources/info_*.iso) are read in place by tests and the
			run-local-* launchers, so they are never copied into target/.
		-->
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
				<excludes>
					<exclude>**/*.iso</exclude>
				</excludes>
			</testResource>
		</testResources>
		<plugins>
			<!-- Coverage excludes: keep in sync with sonar.coverage.exclusions in the parent. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/common/**</exclude>
						<exclude>**/nfiq1/Defs.class</exclude>
						<exclude>**/nfiq1/Nfiq1.class</exclude>
						<exclude>**/nfiq1/Nfiq1Globals.class</exclude>
						<exclude>**/nfiq1/Nist.class</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!--
				Library JAR. Main-Class points at the sample harness in test-classes so
				`java -cp nfiq1.0-*.jar;lib/*;test-classes` works (see run-local-JP2 / run-local-WSQ).
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>true</addClasspath>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
							<mainClass>org.mosip.nist.nfiq1.test.NfiqApplication</mainClass>
						</manifest>
						<manifestEntries>
							<Project-Name>${project.name}</Project-Name>
							<Project-Version>${project.version}</Project-Version>
							<Implementation-Vendor>MOSIP</Implementation-Vendor>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>

			<!--
				Copies jars to target/lib for the sample harness classpath. Test scope so the
				Logback backend (test-only here) is present when the launchers run NfiqApplication.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
							<includeScope>test</includeScope>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>false</overWriteSnapshots>
							<overWriteIfNewer>true</overWriteIfNewer>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
