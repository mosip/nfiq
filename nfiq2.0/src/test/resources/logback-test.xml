<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging for unit tests. Not packaged in the library JAR, so consumers keep their
  own Logback configuration.
-->
<configuration>
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%msg%n</pattern>
		</encoder>
	</appender>

	<logger name="org.mosip.nist.nfiq2" level="INFO" />

	<root level="WARN">
		<appender-ref ref="STDOUT" />
	</root>
</configuration>
