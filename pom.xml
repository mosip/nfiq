<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  MOSIP NFIQ — parent / aggregator POM
  ============================================================================
  Artifact : io.mosip:nfiq (packaging pom) → modules io.mosip:nfiq1.0, io.mosip:nfiq2.0
  Parent   : spring-boot-starter-parent (BOM + plugin versions only;
             no Spring Boot app, no repackage)
  Java     : 21 with enable-preview (compiler, Surefire and runtime)
  MOSIP    : kernel-core + biometrics-util, pinned directly in <properties>.
             kernel-bom is intentionally NOT imported.
  Coverage : JaCoCo gate >= 90% instruction + line per module (jacoco.coverage.ratio)

  Build    : mvn clean install "-Dgpg.skip=true"          (from this folder)
  Run      : nfiq1.0|nfiq2.0 / run-local-JP2.(bat|sh) | run-local-WSQ.(bat|sh)  [build] [0|1]
  CI       : .github/workflows/push-trigger.yml builds, publishes (parent + both modules) and runs Sonar.
  Modules  : nfiq1.0 (NFIQ 1.0), nfiq2.0 (NFIQ 2 v2.3.0; frfxll package LGPL-3.0-or-later).
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Spring Boot parent supplies dependency management (SLF4J, Mockito, JUnit,
		Lombok, commons-lang3 …) and default plugin versions. spring-boot-maven-plugin
		is NOT bound, so modules stay plain library JARs consumable by other MOSIP modules.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath />
	</parent>

	<groupId>io.mosip</groupId>
	<artifactId>nfiq</artifactId>
	<version>0.1.2-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>nfiq</name>
	<description>
		MOSIP fingerprint image quality libraries. Parent POM for nfiq1.0, a from-scratch Java
		implementation of NIST Fingerprint Image Quality 1.0 (ISO/IEC 19794-4 JPEG2000 / WSQ in,
		NFIQ 1 (best) .. 5 (worst) plus confidence out), and nfiq2.0, a Java port of NIST
		NFIQ 2 v2.3.0 on OpenCV (unified quality score 0 .. 100). Java 21 (enable-preview), Spring Boot
		dependency management, no kernel-bom; kernel-core and biometrics-util pinned directly.
	</description>
	<url>https://github.com/mosip/nfiq</url>

	<modules>
		<module>nfiq1.0</module>
		<module>nfiq2.0</module>
	</modules>

	<licenses>
		<license>
			<name>MPL 2.0</name>
			<url>https://www.mozilla.org/en-US/MPL/2.0/</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<scm>
		<connection>scm:git:git://github.com/mosip/nfiq.git</connection>
		<developerConnection>scm:git:ssh://github.com:mosip/nfiq.git</developerConnection>
		<url>https://github.com/mosip/nfiq</url>
		<tag>HEAD</tag>
	</scm>

	<developers>
		<developer>
			<name>MOSIP</name>
			<email>mosip.emailnotifier@gmail.com</email>
			<organization>io.mosip</organization>
			<organizationUrl>https://github.com/mosip/nfiq</organizationUrl>
		</developer>
	</developers>

	<properties>
		<!-- ── Java ─────────────────────────────────────────────────────────── -->
		<java.version>21</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<!-- Empty default required for Surefire late replacement @{argLine} (JaCoCo agent). -->
		<argLine />
		<skipTests>false</skipTests>

		<!-- ── Maven plugins (latest GA) ─────────────────────────────────────── -->
		<maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
		<maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
		<maven.surefire.plugin.version>3.6.0</maven.surefire.plugin.version>
		<maven.jacoco.version>0.8.15</maven.jacoco.version>
		<maven.sonar.plugin.version>5.8.0.7211</maven.sonar.plugin.version>
		<maven.javadoc.version>3.12.0</maven.javadoc.version>
		<maven.deploy.plugin.version>3.1.4</maven.deploy.plugin.version>
		<maven.source.plugin.version>3.4.0</maven.source.plugin.version>
		<maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
		<!-- kattu CI greps pl.project13.maven:git-commit-id-plugin -->
		<git.commit.id.plugin.version>4.9.10</git.commit.id.plugin.version>
		<central.publishing.maven.plugin.version>0.11.0</central.publishing.maven.plugin.version>
		<!-- maven-dependency-plugin / maven-resources-plugin: versions from Boot parent -->

		<!-- ── MOSIP (external — no kernel-bom) ─────────────────────────────── -->
		<!-- SNAPSHOTs: resolved from Central Snapshots or installed locally with mvn install. -->
		<kernel.core.version>1.4.1-SNAPSHOT</kernel.core.version>
		<mosip.biometrics.util.version>1.4.1-SNAPSHOT</mosip.biometrics.util.version>

		<!-- ── Third-party (latest GA on Maven Central) ─────────────────────── -->
		<!-- Source: https://central.sonatype.com/artifact/com.github.jai-imageio/jai-imageio-jpeg2000 -->
		<jai.imageio.jpeg2000.version>1.4.0</jai.imageio.jpeg2000.version>
		<!-- Source: https://central.sonatype.com/artifact/com.github.mhshams/jnbis -->
		<github.mhshams.jnbis.version>2.1.2</github.mhshams.jnbis.version>
		<!-- Must equal the OpenCV version biometrics-util resolves, so only one native library is loaded. -->
		<openpnp.opencv.version>4.9.0-0</openpnp.opencv.version>

		<!--
			Spring Boot BOM overrides: newer GA patch/minor releases than Boot 4.1.1 pins.
			Property names come from spring-boot-dependencies; drop an override once Boot catches up.
		-->
		<jackson-2-bom.version>2.22.3</jackson-2-bom.version>
		<protobuf-java.version>4.36.2</protobuf-java.version>
		<commons-logging.version>1.4.0</commons-logging.version>
		<hibernate-validator.version>9.1.4.Final</hibernate-validator.version>
		<logback.version>1.6.4</logback.version>
		<junit-jupiter.version>6.1.3</junit-jupiter.version>
		<mockito.version>5.24.0</mockito.version>
		<lombok.version>1.18.48</lombok.version>
		<!-- Test scope only (spring-boot-starter-test). -->
		<json-path.version>3.0.0</json-path.version>
		<snakeyaml.version>2.7</snakeyaml.version>
		<xmlunit2.version>2.14.0</xmlunit2.version>

		<!-- ── Coverage / Sonar ─────────────────────────────────────────────── -->
		<!-- Minimum JaCoCo covered ratio (instruction + line) enforced at verify. -->
		<jacoco.coverage.ratio>0.90</jacoco.coverage.ratio>
		<!--
			Excluded from coverage: constant-only interfaces (common/**), static
			definition holders and the tiny facade classes. Keep in sync with the
			jacoco <excludes> in nfiq1.0/pom.xml so local and SonarCloud numbers match.
		-->
		<sonar.coverage.exclusions>**/common/**,**/Defs.java,**/Nfiq1.java,**/Nfiq1Globals.java,**/Nist.java</sonar.coverage.exclusions>
		<sonar.cpd.exclusions>**/common/**</sonar.cpd.exclusions>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!--
				kernel-core: shared MOSIP kernel APIs (exceptions, logger facade, utils).
				Arrives transitively via biometrics-util; pinned here so the whole graph
				resolves to kernel.core.version. Do NOT import kernel-bom. License: MPL-2.0.
			-->
			<dependency>
				<groupId>io.mosip.kernel</groupId>
				<artifactId>kernel-core</artifactId>
				<version>${kernel.core.version}</version>
			</dependency>
			<!--
				biometrics-util: ISO/IEC 19794-4 finger record decoding
				(FingerDecoder, ConvertRequestDto, ImageDecoderRequestDto …). License: MPL-2.0.
			-->
			<dependency>
				<groupId>io.mosip.biometric.util</groupId>
				<artifactId>biometrics-util</artifactId>
				<version>${mosip.biometrics.util.version}</version>
			</dependency>
			<!--
				jai-imageio-jpeg2000: javax.imageio plugin for JPEG2000 (JP2/J2K) payloads.
				License: BSD-3-Clause (with nuclear-use clause) + JJ2000.
			-->
			<dependency>
				<groupId>com.github.jai-imageio</groupId>
				<artifactId>jai-imageio-jpeg2000</artifactId>
				<version>${jai.imageio.jpeg2000.version}</version>
			</dependency>
			<!-- jnbis: WSQ fingerprint codec (NIST Wavelet Scalar Quantization). License: Apache-2.0. -->
			<dependency>
				<groupId>com.github.mhshams</groupId>
				<artifactId>jnbis</artifactId>
				<version>${github.mhshams.jnbis.version}</version>
			</dependency>
			<!--
				opencv (openpnp): OpenCV Java bindings with bundled native libraries, used by
				nfiq2.0 for the image operations of NIST NFIQ 2. License: Apache-2.0 (OpenCV),
				BSD-3-Clause (openpnp packaging).
			-->
			<dependency>
				<groupId>org.openpnp</groupId>
				<artifactId>opencv</artifactId>
				<version>${openpnp.opencv.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<distributionManagement>
		<snapshotRepository>
			<id>ossrh</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
		</snapshotRepository>
		<repository>
			<id>ossrh</id>
			<url>https://central.sonatype.com/api/v1/publisher</url>
		</repository>
	</distributionManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${maven.sonar.plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>${maven.jar.plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- Compile for Java 21 with preview features; Lombok as annotation processor. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven.compiler.plugin.version}</version>
				<configuration>
					<release>${java.version}</release>
					<parameters>true</parameters>
					<compilerArgs>
						<arg>--enable-preview</arg>
					</compilerArgs>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<!-- Unit tests: JaCoCo agent via @{argLine}; preview + reflective opens for tests. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven.surefire.plugin.version}</version>
				<configuration>
					<skipTests>${skipTests}</skipTests>
					<skip>false</skip>
					<argLine>
						@{argLine}
						--enable-preview
						--add-opens java.base/java.lang=ALL-UNNAMED
						--add-opens java.base/java.lang.reflect=ALL-UNNAMED
						--add-opens java.base/java.util=ALL-UNNAMED
						--add-opens java.base/java.util.concurrent.atomic=ALL-UNNAMED
						--add-opens java.desktop/java.awt.image=ALL-UNNAMED
					</argLine>
				</configuration>
			</plugin>

			<!--
				Coverage: agent → report (prepare-package) → gate (verify), per module.
				Module-specific class excludes live in each module's pom.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${maven.jacoco.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.coverage.ratio}</minimum>
										</limit>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.coverage.ratio}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Maven Central attachments: sources, javadoc, GPG signatures (parent POM is signed too). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>${maven.source.plugin.version}</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>${maven.javadoc.version}</version>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<doclint>none</doclint>
					<failOnError>false</failOnError>
					<failOnWarnings>false</failOnWarnings>
					<additionalJOptions>
						<additionalJOption>--enable-preview</additionalJOption>
						<additionalJOption>--release=${java.version}</additionalJOption>
					</additionalJOptions>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-gpg-plugin</artifactId>
				<version>${maven.gpg.plugin.version}</version>
				<executions>
					<execution>
						<id>sign-artifacts</id>
						<phase>verify</phase>
						<goals>
							<goal>sign</goal>
						</goals>
						<configuration>
							<gpgArguments>
								<arg>--pinentry-mode</arg>
								<arg>loopback</arg>
							</gpgArguments>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Publishing to Maven Central (manual release; autoPublish=false). Publishes the whole reactor. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>${maven.deploy.plugin.version}</version>
				<configuration>
					<skip>false</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.sonatype.central</groupId>
				<artifactId>central-publishing-maven-plugin</artifactId>
				<version>${central.publishing.maven.plugin.version}</version>
				<extensions>true</extensions>
				<configuration>
					<publishingServerId>ossrh</publishingServerId>
					<autoPublish>false</autoPublish>
				</configuration>
			</plugin>

			<!--
				Writes git.properties (commit id + build time) into each module JAR.
				The plugin walks up from the module basedir to find the repo's .git.
			-->
			<plugin>
				<groupId>pl.project13.maven</groupId>
				<artifactId>git-commit-id-plugin</artifactId>
				<version>${git.commit.id.plugin.version}</version>
				<executions>
					<execution>
						<id>get-the-git-infos</id>
						<goals>
							<goal>revision</goal>
						</goals>
						<phase>validate</phase>
					</execution>
				</executions>
				<configuration>
					<generateGitPropertiesFile>true</generateGitPropertiesFile>
					<generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
					<includeOnlyProperties>
						<includeOnlyProperty>^git.build.(time|version)$</includeOnlyProperty>
						<includeOnlyProperty>^git.commit.id.(abbrev|full)$</includeOnlyProperty>
					</includeOnlyProperties>
					<commitIdGenerationMode>full</commitIdGenerationMode>
					<failOnNoGitDirectory>false</failOnNoGitDirectory>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- mvn verify -Psonar : SonarCloud analysis (used by kattu CI). -->
		<profile>
			<id>sonar</id>
			<properties>
				<sonar.sources>.</sonar.sources>
				<sonar.inclusions>src/main/java/**,src/main/resources/**</sonar.inclusions>
				<sonar.exclusions>${sonar.coverage.exclusions}</sonar.exclusions>
				<sonar.host.url>https://sonarcloud.io</sonar.host.url>
			</properties>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.sonarsource.scanner.maven</groupId>
						<artifactId>sonar-maven-plugin</artifactId>
						<executions>
							<execution>
								<phase>verify</phase>
								<goals>
									<goal>sonar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<repositories>
		<!-- MOSIP SNAPSHOT artifacts (kernel-core, biometrics-util) are published here. -->
		<repository>
			<id>ossrh</id>
			<name>Central Snapshots</name>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>
</project>
